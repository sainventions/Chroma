{
  "manifest_version": 3,
  "name": "Chroma for claude.ai",
  "short_name": "Chroma",
  "version": "1.3.1",
  "description": "Unofficial theme layer for claude.ai: per-chat and per-tab accent colors, darker and AMOLED backgrounds, accent window glow, hotkeys.",
  "key": "",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Chroma: toggle panel (Alt+Shift+P on the page)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
